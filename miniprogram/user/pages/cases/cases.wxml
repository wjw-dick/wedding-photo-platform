<view class="container">
  <view class="section-title">客片案例</view>
  <view wx:for="{{list}}" wx:key="id" class="card">
    <image wx:if="{{item.cover_url}}" src="{{item.cover_url}}" mode="aspectFill" style="width:100%;height:300rpx;border-radius:8rpx" />
    <view style="margin-top:12rpx">{{item.title}}</view>
  </view>
  <view wx:if="{{!list.length}}" class="muted">暂无已授权公开的客片</view>
</view>
