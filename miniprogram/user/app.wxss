page { background: #f7f3ee; color: #2c2622; font-family: "Songti SC", serif; }
.container { padding: 24rpx; }
.hero { background: linear-gradient(135deg, #4a3a2e, #9a7b5c); color: #fff; padding: 80rpx 40rpx; border-radius: 8rpx; }
.hero .title { font-size: 52rpx; letter-spacing: 8rpx; }
.hero .sub { margin-top: 16rpx; font-size: 26rpx; opacity: .85; }
.card { background: #fff; border-radius: 8rpx; padding: 24rpx; margin-bottom: 20rpx; border: 1rpx solid #e7ded4; }
.row { display: flex; justify-content: space-between; align-items: center; }
.muted { color: #7a6f66; font-size: 24rpx; }
.price { color: #b98b5e; font-size: 32rpx; }
.btn { background: #b98b5e; color: #fff; border-radius: 40rpx; padding: 20rpx; text-align: center; margin-top: 20rpx; }
.input { border: 1rpx solid #e7ded4; border-radius: 8rpx; padding: 20rpx; margin-bottom: 16rpx; background: #fff; }
.section-title { font-size: 34rpx; letter-spacing: 4rpx; margin: 32rpx 0 20rpx; }
