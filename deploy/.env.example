# ===== 复制为 deploy/.env 后修改，切勿提交真实密钥 =====
MYSQL_DB=wedding_platform
MYSQL_ROOT_PASSWORD=change-me-strong
REDIS_PASSWORD=change-me-redis
RABBIT_USER=wedding
RABBIT_PASSWORD=change-me-rabbit
RABBIT_VHOST=/wedding

JWT_SECRET=change-me-at-least-48-chars-random-string-for-production
AES_KEY=change-me-32-bytes-key-000000000

MINIO_ACCESS_KEY=wedding
MINIO_SECRET_KEY=change-me-minio

# 对外访问
PUBLIC_WEB_BASE=https://demo.wedding.example.com
PUBLIC_API_BASE=https://api.wedding.example.com

# 证书路径（Nginx 容器内）
TLS_CERT=/etc/nginx/certs/fullchain.pem
TLS_KEY=/etc/nginx/certs/privkey.pem
